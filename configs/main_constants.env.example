# MoSAR reproducibility environment template.
# Copy this file to configs/main_constants.env and edit the values for your cluster.
# The Slurm templates source configs/main_constants.env automatically when it exists.

# Repository root. Usually inferred by the scripts; set explicitly on clusters that copy
# Slurm scripts to a temporary submission directory.
# REPO_ROOT=/path/to/mosar-anonymous

# Writable high-capacity storage. Required for training/evaluation outputs.
SCRATCH_ROOT=/path/to/scratch

# Runtime code. Defaults to ${REPO_ROOT}/runtime_source.
# RUNTIME_SOURCE=${REPO_ROOT}/runtime_source

# External dependencies. These are intentionally not vendored in the anonymous repo.
MEGATRON_BRIDGE_PATH=/path/to/Megatron-Bridge
CONTAINER_PATH=/path/to/megatron_bridge_container.sif

# Data/tokenizer. DATA_PREFIX must omit the .bin/.idx suffix.
DATA_PREFIX=/path/to/megatron_indexed_dataset/text_document
TOKENIZER_PATH=/path/to/tokenizer_directory

# Slurm options. The submit wrappers add these only when non-empty.
SBATCH_ACCOUNT=
SBATCH_PARTITION=
SBATCH_QOS=
# Example: SBATCH_EXTRA_ARGS="--constraint=a100 --reservation=my_reservation"
SBATCH_EXTRA_ARGS=

# Experiment identity.
GROUP=anonymous_main_v1
MODEL_SEED=1239
DATA_SEED=2031

# Canonical training/evaluation scale.
TOTAL_STEPS=610000
SEQUENCE_LENGTH=2048
GLOBAL_BATCH_SIZE=8
MICRO_BATCH_SIZE=1
TOKENS_PER_STEP=16384

LEARNING_RATE=3e-4
MIN_LEARNING_RATE=3e-5
LR_WARMUP_STEPS=100
COST_WARMUP_STEPS=500
SAVE_INTERVAL=10000
EVAL_ITERS=64

# Output layout. Checkpoints are external artifacts and should not be committed.
RUN_ROOT=${SCRATCH_ROOT}/mosar_main_v1
POST_RUN_ROOT=${SCRATCH_ROOT}/mosar_posttraining_v1
CHECKPOINT_ROOT=${RUN_ROOT}/checkpoints
ARTIFACT_ROOT=${RUN_ROOT}/artifacts
EVAL_ROOT=${RUN_ROOT}/evals
POST_EVAL_ROOT=${POST_RUN_ROOT}/evals
LOG_ROOT=${RUN_ROOT}/logs
POST_LOG_ROOT=${POST_RUN_ROOT}/logs

# Approximate corpus/training-budget metadata used in the paper.
ESTIMATED_CORPUS_TOKENS=4975435463
TARGET_TRAINING_TOKENS=10000000000
TARGET_STEPS_APPROX=610000
MILESTONE_300K_TOKENS_APPROX=4915200000
MILESTONE_610K_TOKENS_APPROX=9994240000
